# ===========================================================================
# IVD MySQL 自定义参数（叠加在官方镜像默认配置之上）
# 文件名 zz-ivd.cnf 保证最后加载、覆盖默认值
# ===========================================================================
[mysqld]
# 字符集（PRD 9.5：utf8mb4 全 Unicode，含试剂名生僻字）
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# 时区
default-time-zone    = '+08:00'

# 连接与缓冲（二甲~三甲规模，按 8C/16-32G 调）
max_connections      = 500
innodb_buffer_pool_size = 2G
innodb_log_file_size     = 512M
innodb_flush_log_at_trx_commit = 1

# 慢查询（PRD 9.1 性能指标监控用）
slow_query_log       = ON
long_query_time      = 2
log_queries_not_using_indexes = OFF

# binlog（备份恢复 + 未来读写分离预留）
server-id            = 1
log_bin              = mysql-bin
binlog_format        = ROW
binlog_expire_logs_seconds = 604800

# 分区表支持（udi_status_log 按月 RANGE 分区）
# MySQL 8 默认支持，无需额外参数

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
