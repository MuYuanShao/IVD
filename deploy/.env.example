# ===========================================================================
# IVD 一期部署环境变量 — 拷贝为 .env 后按医院实际修改
# ⚠️ 生产环境务必修改所有默认密码！
# ===========================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=Root@123456
MYSQL_DATABASE=ivd
MYSQL_USER=ivd
MYSQL_PASSWORD=Ivd@123456
MYSQL_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=Redis@123456
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=ivdadmin
MINIO_ROOT_PASSWORD=Minio@123456
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- XXL-Job ----
XXL_JOB_ACCESS_TOKEN=xxl-job-token-ivd
XXL_JOB_PORT=8081

# ---- 主应用 ----
# 镜像名（CI 构建后推送，部署时填写实际 tag）
IVD_APP_IMAGE=ivd/ivd-app:1.0.0-mvp
APP_PORT=8080

# ---- Web 入口 ----
WEB_PORT=80
WEB_HTTPS_PORT=443
